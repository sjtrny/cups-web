# Brother bundle: the Docker host's LAN IPv4 address.
PRINT_HOST=192.168.20.10
# Brother QL-1110NWB Ethernet endpoint.
PRINTER_URI=socket://192.168.20.214:9100
# 4 x 6 inch labels on 102 mm continuous roll; use a driver preset for other rolls.
LABEL_MEDIA=4x6
WEB_PORT=18680
# Used only with compose.ghcr.yaml; choose latest or sha-FULL_COMMIT_SHA.
IMAGE_TAG=latest
# Standalone compose.web.yaml: connect to an existing CUPS server instead.
# CUPS_SERVER=192.168.1.20:631
# WEB_BIND=127.0.0.1
